---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import TagList from "../../components/TagList.astro";
import type { MarkdownInstance } from "astro";
import { sortByDate, tagsOf, type Post, type PostFrontmatter } from "../../lib/posts";

type TagPath = { params: { tag: string }; props: Props };

export async function getStaticPaths(): Promise<TagPath[]> {
  const allPosts: MarkdownInstance<PostFrontmatter>[] = await Astro.glob("../posts/*.{md,mdx}");
  const tags: string[] = [...new Set(allPosts.flatMap(tagsOf))];

  return tags.map((tag: string) => ({
    params: { tag },
    props: { tags, posts: sortByDate(allPosts.filter((post: Post) => tagsOf(post).includes(tag))) },
  }));
}

type Props = { tags: string[]; posts: Post[] };
const { tag } = Astro.params;
const { tags, posts } = Astro.props;
---

<BaseLayout title={`Notes tagged “${tag}”`} description={`Notes by Israel Chidera Edeh tagged ${tag}.`}>
  <section class="page pb-20 pt-14 sm:pb-28 sm:pt-20">
    <p class="eyebrow">Notes · tag</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{tag}</h1>
    <div class="mt-8"><TagList tags={tags} current={tag} /></div>
    <ul class="mt-8 divide-y divide-line border-y border-line">
      {posts.map((post) => <BlogPost post={post} />)}
    </ul>
  </section>
</BaseLayout>
