---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import TagList from "../components/TagList.astro";
import Icon from "../components/Icon.astro";
import { links } from "../data/site";
import type { MarkdownInstance } from "astro";
import { sortByDate, tagsOf, type PostFrontmatter } from "../lib/posts";

const allPosts = sortByDate(await Astro.glob<MarkdownInstance<PostFrontmatter>>("./posts/*.{md,mdx}"));
const tags = [...new Set(allPosts.flatMap(tagsOf))];
---

<BaseLayout title="Notes" description="Notes and short articles by Israel Chidera Edeh on web development, frameworks and C#.">
	<section class="page pb-20 pt-14 sm:pb-28 sm:pt-20">
		<p class="eyebrow">Notes</p>
		<h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">Notes & articles</h1>
		<p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
			Shorter pieces published on this site. Most of my tutorials are on
			<a href={links.freecodecamp} class="link text-fg" rel="noopener">freeCodeCamp News</a>.
		</p>
		<div class="mt-8"><TagList tags={tags} /></div>
		<ul class="mt-8 divide-y divide-line border-y border-line">
			{allPosts.map((post) => <BlogPost post={post} />)}
		</ul>
		<p class="mt-8">
			<a href="/#writing" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg">
				<Icon name="arrow-left" /> Back to featured writing
			</a>
		</p>
	</section>
</BaseLayout>
