---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Page not found">
    <section class="page flex min-h-[60vh] flex-col justify-center py-20">
        <p class="eyebrow">404</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">This page doesn't exist.</h1>
        <p class="mt-4 max-w-xl text-lg text-muted">It may have moved when the site was redesigned.</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/" class="btn-primary"><Icon name="arrow-left" /> Back home</a>
            <a href="/#work" class="btn-secondary">See projects</a>
        </div>
    </section>
</BaseLayout>
