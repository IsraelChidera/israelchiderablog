---
type Props = { id: string; number: string; label: string; title: string; intro?: string };
const { id, number, label, title, intro } = Astro.props;
---

<div class="mb-10 grid gap-4 border-t border-line pt-6 sm:mb-12 lg:grid-cols-12 lg:gap-10">
	<p class="eyebrow lg:col-span-3"><span class="text-fg">{number}</span>&nbsp;&nbsp;{label}</p>
	<div class="lg:col-span-9">
		<h2 id={id} class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
		{intro && <p class="mt-3 max-w-2xl leading-relaxed text-muted">{intro}</p>}
	</div>
</div>
