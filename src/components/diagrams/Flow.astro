---
// A left-to-right flow of steps that stacks vertically on small screens.
type Step = { label: string; detail?: string; muted?: boolean };
type Props = { steps: Step[]; class?: string };
const { steps, class: className = "" } = Astro.props;
---

<ol class={`flex flex-col items-stretch gap-2 md:flex-row md:items-center ${className}`}>
	{
		steps.map((step, i) => (
			<>
				{i > 0 && (
					<li aria-hidden="true" class="flex justify-center text-muted md:px-0.5">
						<span class="font-mono text-sm md:hidden">↓</span>
						<span class="hidden font-mono text-sm md:inline">→</span>
					</li>
				)}
				<li
					class:list={[
						"min-w-0 flex-1 rounded-xl border px-3 py-2.5",
						step.muted ? "border-dashed border-line bg-transparent" : "border-line bg-surface",
					]}
				>
					<p class="text-[13px] font-medium leading-snug">{step.label}</p>
					{step.detail && <p class="mt-0.5 font-mono text-[11px] leading-snug text-muted">{step.detail}</p>}
				</li>
			</>
		))
	}
</ol>
