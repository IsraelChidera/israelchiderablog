---
import { formatDate, tagsOf, type Post } from "../lib/posts";
type Props = { post: Post };
const { post } = Astro.props;
const { title, description, pubDate } = post.frontmatter;
---

<li>
	<a href={post.url} class="group grid gap-1 py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
		<time datetime={new Date(pubDate).toISOString().slice(0, 10)} class="font-mono text-xs text-muted sm:pt-1.5">
			{formatDate(pubDate)}
		</time>
		<span>
			<span class="block text-lg font-medium leading-snug tracking-tight group-hover:text-accent">{title}</span>
			{description && description !== title && <span class="mt-1 block text-sm text-muted">{description}</span>}
			<span class="mt-2 block font-mono text-[11px] uppercase tracking-wider text-muted">{tagsOf(post).join(" · ")}</span>
		</span>
	</a>
</li>
