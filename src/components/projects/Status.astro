---
import type { ProjectStatus } from "../../data/projects";
type Props = { status: ProjectStatus; label: string };
const { status, label } = Astro.props;
const tone = { live: "bg-ok", "in-progress": "bg-warn", internal: "bg-muted", shipped: "bg-accent" }[status];
---

<span class="chip"><span class={`h-1.5 w-1.5 rounded-full ${tone}`} aria-hidden="true"></span>{label}</span>
