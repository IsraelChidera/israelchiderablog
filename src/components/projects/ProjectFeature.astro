---
// Homepage project entry. `layout="wide"` gives a project the full row; "stacked" is for the paired cards.
import type { Project } from "../../data/projects";
import Icon from "../Icon.astro";
import Status from "./Status.astro";
import ProjectVisual from "./ProjectVisual.astro";

type Props = { project: Project; index: number; layout?: "wide" | "stacked" };
const { project, index, layout = "wide" } = Astro.props;
const caseStudy = `/projects/${project.slug}/`;
const wide = layout === "wide";
---

<article
	class:list={[
		"card grid gap-6 p-5 sm:p-7",
		wide ? "lg:grid-cols-12 lg:gap-10 lg:p-8" : "content-start",
	]}
	aria-labelledby={`project-${project.slug}`}
>
	<div class:list={["flex flex-col", wide && "lg:col-span-5"]}>
		<div class="flex flex-wrap items-center gap-2">
			<span class="font-mono text-xs text-muted">{String(index).padStart(2, "0")}</span>
			<span class="text-xs text-muted">{project.kind}</span>
			<Status status={project.status} label={project.statusLabel} />
		</div>

		<h3 id={`project-${project.slug}`} class="mt-4 text-2xl font-semibold tracking-tight sm:text-[1.75rem]">
			<a href={caseStudy} class="hover:text-accent">{project.title}</a>
		</h3>
		<p class="mt-3 leading-relaxed text-muted">{project.summary}</p>

		{
			project.outcomes && (
				<dl class="mt-6 grid grid-cols-3 gap-3 border-t border-line pt-5">
					{project.outcomes.map(({ value, label }) => (
						<div class="flex flex-col-reverse justify-end">
							<dt class="mt-1 text-xs leading-snug text-muted">{label}</dt>
							<dd class="text-2xl font-semibold tracking-tight">{value}</dd>
						</div>
					))}
				</dl>
			)
		}

		<p class="mt-5 font-mono text-xs leading-relaxed text-muted">{project.stack.join(" · ")}</p>
		{project.note && <p class="mt-3 text-xs text-muted">{project.note.split(". ")[0]}.</p>}

		<div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 pt-1 lg:mt-auto lg:pt-6">
			<a href={caseStudy} class="group inline-flex items-center gap-1.5 text-sm font-medium">
				Read case study<span class="sr-only">: {project.title}</span>
				<Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
			</a>
			{
				project.links.map(({ label, href }) => (
					<a href={href} class="inline-flex items-center gap-1 text-sm text-muted hover:text-fg" rel="noopener">
						{label}<span class="sr-only"> ({project.title})</span>
						<Icon name="arrow-up-right" class="h-3.5 w-3.5" />
					</a>
				))
			}
		</div>
	</div>

	<div class:list={[wide && "lg:col-span-7 lg:self-center", !wide && "order-first"]}>
		<ProjectVisual project={project} compact />
	</div>
</article>
